class Solution {
    public int[] separateDigits(int[] nums) {
        List<Integer> l=new ArrayList<>();
        for(int i=nums.length-1;i>=0;i--)
        {
            int x=nums[i];
            while(x>0)
            {
                l.add(x%10);
                x/=10;
            } 
        }
        Collections.reverse(l);
        int a[]=new int[l.size()];
        int i=0;
        for(int n:l)
            a[i++]=n;
        return a;
    }
}
