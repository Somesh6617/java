class Solution {
    public int maxProductDifference(int[] nums) {
        int mi1=Integer.MAX_VALUE;
        int mi2=Integer.MAX_VALUE;
        int ma1=Integer.MIN_VALUE;
        int ma2=Integer.MIN_VALUE;
        for(int i=0;i<nums.length;i++)
        {
            int n=nums[i];
            if(n>ma1)
            {
                ma2=ma1;
                ma1=n;
            }
            else if(n > ma2 ) ma2=n;
            if(n<mi1)
            {
                mi2=mi1;
                mi1=n;
            }
            else if(n < mi2 ) mi2=n;
        }
        return (ma1*ma2)-(mi1*mi2);
    }
}
