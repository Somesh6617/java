class Solution {
    public int[] decompressRLElist(int[] nums) {
        int s=0;
        for(int i=0;i<nums.length;i+=2)
            s+=nums[i];
        int a[]=new int[s];
        int x=0;
        for(int i=0;i<nums.length;i+=2)
        {
            Arrays.fill(a,x,x+nums[i],nums[i+1]);
            x+=nums[i];

        }
        return a;
    }
}
