class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        List<Boolean> b =new ArrayList<>();
        int ma=Integer.MIN_VALUE;
        for(int i=0;i<candies.length;i++)
            ma=Math.max(ma,candies[i]);
        for(int i=0;i<candies.length;i++)
        {
            if((candies[i]+extraCandies)>=ma)
                b.add(true);
            else b.add(false);
        }
        return b;
    }
}
