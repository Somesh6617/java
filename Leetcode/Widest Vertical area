class Solution {
    public int maxWidthOfVerticalArea(int[][] points) {
        int a[]=new int[points.length];
        for(int i=0;i<points.length;i++)
            a[i]=points[i][0];
        Arrays.sort(a);
        int ma=Integer.MIN_VALUE;
        for(int i=1;i<a.length;i++)
            ma=Math.max(ma,a[i]-a[i-1]);
        return ma;
    }
}
