class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        int mi = 101, ma = 1;
        for (int x : nums) {
            mi = Math.min(mi, x);
            ma = Math.max(ma, x);
        }
        int[] freq = new int[ma - mi + 1];
        for (int x : nums) {
            freq[x - mi]++;
        }
        List<Integer> ans = new ArrayList<>();
        for (int i = 0; i < freq.length; i++) {
            if (freq[i] == 0) {
                ans.add(i + mi);
            }
        }
        return ans;
    }
}
