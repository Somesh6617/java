class Solution {
    public int[] getSneakyNumbers(int[] nums) {
        int a[]=new int[2];
        int n=nums.length;
        int x=0;
        for(int i=0;i<n;i++)
        {
            for(int j=i;j<n;j++)
            {
                if((nums[i]==nums[j])&&i!=j)
                a[x++]=nums[i];
            }
        }
        return a;
    }
}
