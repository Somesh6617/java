class Solution {
    public String maximumOddBinaryNumber(String s) {
        int ones=0;
        for(char ch:s.toCharArray())
            if(ch=='1') ones++;
        StringBuilder ans=new StringBuilder();
        ans.append("1".repeat(ones - 1));
        ans.append("0".repeat(s.length() - ones));
        ans.append("1");
        return ans.toString();
    }
}
